<?xml version="1.0" encoding="utf-8"?>
<!--
  The host frame. Everything the user actually interacts with lives in the screen container; the
  banner and the startup cover are drawn over whichever screen happens to be showing, because
  neither of them is a reason to interrupt what the user is doing.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121418">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      Model download: a banner, not a blocker. Reading text works perfectly well while the weights
      are still arriving, so this reports progress without taking the camera away.
    -->
    <LinearLayout
        android:id="@+id/downloadBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="#E6101418"
        android:padding="16dp"
        android:elevation="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtDownloadTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/download_title" />

        <TextView
            android:id="@+id/txtDownloadDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#B9C0CC"
            android:textSize="13sp"
            android:text="@string/download_banner_detail" />

        <ProgressBar
            android:id="@+id/barDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0" />

    </LinearLayout>

    <!--
      Startup: a full cover, because there is genuinely nothing to show yet. The camera has not
      produced a frame and the OCR models are still being opened, so the alternative is the black
      rectangle of an unbound PreviewView.
    -->
    <LinearLayout
        android:id="@+id/startupOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#121418"
        android:padding="32dp"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:id="@+id/startupSpinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtStartupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/txtStartupDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#B9C0CC"
            android:textSize="15sp"
            android:text="@string/startup_camera" />

    </LinearLayout>

</FrameLayout>
