<?xml version="1.0" encoding="utf-8"?>
<!--
  The host frame. Everything the user actually interacts with lives in the screen container; the
  banner and the startup cover are drawn over whichever screen happens to be showing, because
  neither of them is a reason to interrupt what the user is doing.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121418">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      Startup: a full cover, because there is genuinely nothing to show yet. The camera has not
      produced a frame, so the alternative is the black
      rectangle of an unbound PreviewView.
    -->
    <LinearLayout
        android:id="@+id/startupOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#121418"
        android:padding="32dp"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:id="@+id/startupSpinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtStartupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/txtStartupDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#B9C0CC"
            android:textSize="15sp"
            android:text="@string/startup_camera" />

    </LinearLayout>

</FrameLayout>
