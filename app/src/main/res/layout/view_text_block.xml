<?xml version="1.0" encoding="utf-8"?>
<!--
  One block of text as one target.

  It is a TextView rather than a Button so the whole block stays readable on screen: a sighted user
  reads it, a blind user hears it, and both are tapping exactly the thing they are working with.
  The button semantics are restored in code, where the accessibility label is also set.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_text_block"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="64dp"
    android:padding="16dp"
    android:textColor="#FFFFFF"
    android:textSize="18sp"
    android:lineSpacingExtra="4dp" />
