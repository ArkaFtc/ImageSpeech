<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050607">

    <ImageView
        android:id="@+id/imgShot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050607"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <FrameLayout
        android:id="@+id/blockList"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/btnRetake"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:text="@string/new_photo"
        android:contentDescription="@string/new_photo_description" />

    <ImageButton
        android:id="@+id/btnReviewSettings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_round_control"
        android:contentDescription="@string/processing_settings"
        android:padding="14dp"
        android:src="@drawable/ic_settings_lines" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="16dp"
        android:background="#CC121418"
        android:fillViewport="true">

        <TextView
            android:id="@+id/txtReviewStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="@string/review_loading"
            android:textColor="#FFFFFF"
            android:textIsSelectable="true"
            android:textSize="16sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#DD121418"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReadAll"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/read_all"
                android:contentDescription="@string/read_all_description" />

            <Button
                android:id="@+id/btnSummarize"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/summarize"
                android:contentDescription="@string/summarize_description" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/stop" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/errorActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/retry" />
            <Button
                android:id="@+id/btnReadLocally"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/read_locally" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/editQuestion"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="#FFFFFFFF"
                android:hint="@string/type_question"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#121418"
                android:textColorHint="#626A76" />
            <Button
                android:id="@+id/btnTypedAsk"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:text="@string/ask" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAsk"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:text="@string/hold_to_ask"
            android:textSize="18sp"
            android:contentDescription="@string/hold_to_ask_description" />
    </LinearLayout>

</FrameLayout>
