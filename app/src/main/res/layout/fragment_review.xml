<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050607">

    <ImageView
        android:id="@+id/imgShot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050607"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <FrameLayout
        android:id="@+id/blockList"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      Controls in one column over the photo. The spacer leaves the middle of the photo visible and
      tappable; while the keyboard is open the text box takes its place instead (ReviewFragment).
    -->
    <LinearLayout
        android:id="@+id/reviewPanels"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <Button
                android:id="@+id/btnRetake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/new_photo"
                android:contentDescription="@string/new_photo_description" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnStop"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_round_control"
                android:contentDescription="@string/stop_description"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_stop" />

            <ImageButton
                android:id="@+id/btnReviewSettings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_round_control"
                android:contentDescription="@string/processing_settings"
                android:padding="14dp"
                android:src="@drawable/ic_settings_lines" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/statusScroll"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#CC121418"
            android:fillViewport="true">

            <TextView
                android:id="@+id/txtReviewStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="@string/review_loading"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/textTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRepeat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="@string/repeat"
                android:contentDescription="@string/repeat_description" />

            <Button
                android:id="@+id/btnTextSmaller"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:minWidth="64dp"
                android:minHeight="52dp"
                android:text="@string/text_smaller_symbol"
                android:textSize="14sp"
                android:contentDescription="@string/text_smaller" />

            <Button
                android:id="@+id/btnTextLarger"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:minWidth="64dp"
                android:minHeight="52dp"
                android:text="@string/text_larger_symbol"
                android:textSize="26sp"
                android:contentDescription="@string/text_larger" />
        </LinearLayout>

        <View
            android:id="@+id/reviewSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#DD121418"
            android:orientation="vertical"
            android:padding="12dp">

            <Button
                android:id="@+id/btnMoreDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minHeight="52dp"
                android:text="@string/more_detail"
                android:contentDescription="@string/more_detail_description"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/readActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnReadAll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/read_all"
                    android:contentDescription="@string/read_all_description" />

                <Button
                    android:id="@+id/btnSummarize"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/summarize"
                    android:contentDescription="@string/summarize_description" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/errorActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">
                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/retry" />
                <Button
                    android:id="@+id/btnReadLocally"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/read_locally" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/editQuestion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="56dp"
                    android:background="#FFFFFFFF"
                    android:hint="@string/type_question"
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#121418"
                    android:textColorHint="#626A76" />
                <Button
                    android:id="@+id/btnTypedAsk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:minHeight="56dp"
                    android:text="@string/ask" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAsk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="64dp"
                android:text="@string/hold_to_ask"
                android:textSize="18sp"
                android:contentDescription="@string/hold_to_ask_description" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
