<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121418"
    android:orientation="vertical"
    android:padding="16dp">

    <FrameLayout
        android:id="@+id/cameraFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_camera_frame"
        android:padding="3dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/camera_preview" />

        <TextView
            android:id="@+id/txtCaptureStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#99000000"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="@string/capture_hint" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_round_control"
            android:contentDescription="@string/processing_settings"
            android:padding="14dp"
            android:src="@drawable/ic_settings_lines" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_round_control"
            android:contentDescription="@string/profile_description"
            android:padding="14dp"
            android:src="@drawable/ic_person" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="64dp"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnZoomOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/zoom_out_symbol"
                android:textSize="24sp"
                android:contentDescription="@string/zoom_out" />

            <Button
                android:id="@+id/btnZoomIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginStart="8dp"
                android:minWidth="48dp"
                android:text="@string/zoom_in_symbol"
                android:textSize="22sp"
                android:contentDescription="@string/zoom_in" />
        </LinearLayout>
    </FrameLayout>

    <Button
        android:id="@+id/btnShutter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="88dp"
        android:textSize="22sp"
        android:text="@string/take_photo"
        android:contentDescription="@string/take_photo_description" />

</LinearLayout>
