<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

    <TextView
        android:id="@+id/txtProcessingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/gemini_settings_explanation" />

    <EditText
        android:id="@+id/editApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/gemini_api_key"
        android:inputType="textPassword"
        android:importantForAutofill="noExcludeDescendants"
        android:maxLines="1" />

    <CheckBox
        android:id="@+id/checkShowKey"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/show_api_key" />

    <Button
        android:id="@+id/btnShareKeyQr"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/share_key_qr" />

    <Button
        android:id="@+id/btnScanKeyQr"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/scan_key_qr" />

    <Button
        android:id="@+id/btnImportKeyQr"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/import_key_qr_image" />
    </LinearLayout>
</ScrollView>
