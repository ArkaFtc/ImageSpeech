<?xml version="1.0" encoding="utf-8"?>
<!-- The profile stays on this phone: not in cloud backups, not copied to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="profile.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="profile.xml" />
    </device-transfer>
</data-extraction-rules>
